diff --git a/src/Ryujinx.Graphics.Shader/CodeGen/Spirv/Instructions.cs b/src/Ryujinx.Graphics.Shader/CodeGen/Spirv/Instructions.cs
index 79383ec..611dfff 100644
--- a/src/Ryujinx.Graphics.Shader/CodeGen/Spirv/Instructions.cs
+++ b/src/Ryujinx.Graphics.Shader/CodeGen/Spirv/Instructions.cs
@@ -505,7 +505,11 @@ namespace Ryujinx.Graphics.Shader.CodeGen.Spirv
 
         private static OperationResult GenerateDiscard(CodeGenContext context, AstOperation operation)
         {
-            context.Kill();
+            // Maxwell KIL keeps the pixel running as a helper invocation: its quad neighbours still get valid derivatives
+            // for implicit-LOD samples after the discard. OpKill would terminate the invocation and leave them undefined.
+            context.AddCapability(Capability.DemoteToHelperInvocationEXT);
+            context.AddExtension("SPV_EXT_demote_to_helper_invocation");
+            context.DemoteToHelperInvocationEXT();
             return OperationResult.Invalid;
         }
 
diff --git a/src/Ryujinx.Graphics.Shader/CodeGen/Spirv/SpirvGenerator.cs b/src/Ryujinx.Graphics.Shader/CodeGen/Spirv/SpirvGenerator.cs
index e156144..1d8209e 100644
