<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline harness: raw Maxwell SPH+SASS -> SPIR-V via Ryujinx.Graphics.Shader (MIT, Ryubing fork).
       Based on Ryujinx.ShaderTools/Program.cs (MIT). Source only; no game data here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <BaseOutputPath>..\..\tools\shader_harness\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>..\..\tools\shader_harness\obj\</BaseIntermediateOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="..\..\tools\ref\ryubing-ryujinx\src\Ryujinx.Graphics.Shader\Ryujinx.Graphics.Shader.csproj" />
  </ItemGroup>
</Project>
